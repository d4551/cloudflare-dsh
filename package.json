{
  "name": "cloudflare-dsh-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.20.3 || >=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "stryker": "stryker run && bun scripts/verify-mutation-files.ts",
    "publint": "bun run --filter '*' publint",
    "knip": "knip",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "test:invariants": "vitest run --config vitest.invariants.config.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.3",
    "@vitest/coverage-v8": "5.0.1",
    "knip": "6.36.0",
    "oxc-parser": "0.150.0",
    "oxc-transform": "0.150.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
