{
  "name": "cloudflare-dsh",
  "version": "0.1.0",
  "description": "Cloudflare tools, AI Gateway model provider, and MCP passthrough for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cloudflare",
    "ai-gateway",
    "workers-ai"
  ],
  "exports": {
    "./tools/ai": {
      "types": "./lib/types/tools/ai.d.ts",
      "default": "./lib/tools/ai.js"
    },
    "./tools/data": {
      "types": "./lib/types/tools/data.d.ts",
      "default": "./lib/tools/data.js"
    },
    "./tools/web": {
      "types": "./lib/types/tools/web.d.ts",
      "default": "./lib/tools/web.js"
    },
    "./tools/meta": {
      "types": "./lib/types/tools/meta.d.ts",
      "default": "./lib/tools/meta.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "presets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@d4551/dsh-cloudflare-core": "workspace:*",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1"
  }
}