{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      {
        "roles": ["figure", "tabpanel"],
        "tags": ["figure"]
      }
    ],
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expectTypeOf",
          "assert",
          "assertType",
          "expectNoViolations",
          "expectText",
          "expectVisible"
        ]
      }
    ],
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ]
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["node_modules", "lib", "dist", "coverage", "reports", ".stryker-tmp"]
}
