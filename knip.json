{
  "workspaces": {
    ".": {
      "entry": ["stryker.config.json", "tests/**/*.test.ts", "scripts/**/*.ts"],
      "project": ["*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/bundle": {
      "entry": ["src/tools/*.ts", "src/tools/*/index.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/client": {
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
      "entry": ["tests/e2e-entry.tsx"]
    }
  }
}
