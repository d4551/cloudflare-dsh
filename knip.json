{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "stryker.config.json",
        "tests/**/*.test.ts"
      ],
      "project": [
        "*.ts",
        "tests/**/*.ts"
      ]
    },
    "packages/core": {
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "packages/bundle": {
      "entry": [
        "src/tools/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "packages/client": {
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}"
      ]
    }
  }
}
